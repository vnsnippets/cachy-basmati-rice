source = ./modules/variables.conf

# https://wiki.hypr.land/Configuring/Permissions/
permission = /usr/(bin|local/bin)/grim, screencopy, allow
permission = /usr/(bin|local/bin)/hyprlock, screencopy, allow
permission = /usr/(lib|libexec|lib64)/xdg-desktop-portal-hyprland, screencopy, allow
# permission = /usr/(bin|local/bin)/hyprpicker, screencopy, allow
# permission = /usr/(bin|local/bin)/hyprpm, plugin, allow

# https://wiki.hypr.land/Configuring/Keywords/
$terminal = kitty
$fileManager = nautilus
$menu = rofi -show drun -theme $HOME/.config/rofi/theme.rasi

# https://wiki.hypr.land/Configuring/Environment-variables/

# ZSH shell configurations
env = ZDOTDIR, $HOME/.config/zsh

# Theme and general configurations
env = XCURSOR_THEME, Bibata-Modern-Ice
env = XCURSOR_SIZE, 24

env = HYPRCURSOR_THEME, Bibata-Modern-Ice
env = HYPRCURSOR_SIZE, 24
# env = GTK_THEME, catppuccin-frappe-teal-standard+default

# Language and time configurations
env = LC_TIME, en_GB.UTF-8

# .NET development environment configurations
env = DOTNET_ROOT, /usr/bin/dotnet
env = PATH, $PATH:/usr/bin/dotnet:/usr/bin/dotnet/tools

# Quickshell configurations
env = QML_IMPORT_PATH, $HOME/.config/quickshell/Plugins
# env = QT_QPA_PLATFORM, wayland
# env = QSG_RHI_BACKEND, opengl

# Other application configurations
env = EDITOR, nano
# env = HYPRSHOT_DIR, $HOME/Pictures/Screenshots

misc:disable_splash_rendering = 1

source = ./modules/autostart.conf
source = ./modules/monitors.conf
source = ./modules/theme.conf
source = ./modules/animations.conf
source = ./modules/devices.conf
source = ./modules/bindings.conf
source = ./modules/rules.conf
source = ./modules/ecosystem.conf
